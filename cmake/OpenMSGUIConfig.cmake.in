@PACKAGE_INIT@

### CMake package configuration of the OpenMS GUI library (OpenMS-TOPP-GUI).
###
###   find_package(OpenMSGUI CONFIG REQUIRED)
###   target_link_libraries(myapp PRIVATE OpenMS::OpenMS_GUI)
###
### Provides the imported target OpenMS::OpenMS_GUI (and the alias OpenMS_GUI). It
### links the OpenMS core and CLI layers (OpenMS::OpenMS, OpenMS::OpenMS_CLI) and
### Qt 6, which this file finds first. The OpenMS core's own package delegates its
### component GUI here, so find_package(OpenMS CONFIG COMPONENTS GUI) is equivalent.
###
### Variables:
###   OpenMSGUI_VERSION          version of the GUI layer (= the OpenMS version)
###   OpenMSGUI_QT_COMPONENTS    the Qt 6 modules OpenMS_GUI links publicly
###   OPENMS_GUI_DATA_DIR, OPENMS_GUI_BIN_DIR, OPENMS_GUI_LIB_DIR
###                              directories of this installation

if(CMAKE_VERSION VERSION_LESS 3.24)
  set(OpenMSGUI_FOUND FALSE)
  set(OpenMSGUI_NOT_FOUND_MESSAGE
      "OpenMSGUI requires CMake 3.24 or newer in the consuming project (running ${CMAKE_VERSION}).")
  return()
endif()

## evaluated before any dependency lookup: a nested configure_package_config_file()
## package resets PACKAGE_PREFIX_DIR
set(OPENMS_GUI_DATA_DIR "@PACKAGE_INSTALL_SHARE_DIR@")
set(OPENMS_GUI_BIN_DIR "@PACKAGE_INSTALL_BIN_DIR@")
set(OPENMS_GUI_LIB_DIR "@PACKAGE_INSTALL_LIB_DIR@")
set(OpenMSGUI_QT_COMPONENTS @OPENMS_GUI_PACKAGE_QT_MODULES@)

include(CMakeFindDependencyMacro)

## The OpenMS core with its CLI layer, of the version the GUI layer was built against.
## Usually installed into the same prefix (lib/cmake/OpenMS next to lib/cmake/OpenMSGUI,
## or CMake/ for both on Windows). Not searched again when OpenMS was found already, e.g.
## when OpenMSConfig.cmake delegates its component GUI here.
if(NOT TARGET OpenMS::OpenMS_CLI)
  find_dependency(OpenMS @OPENMS_PACKAGE_VERSION@ EXACT CONFIG COMPONENTS CLI
                  HINTS "${CMAKE_CURRENT_LIST_DIR}/../OpenMS" "${CMAKE_CURRENT_LIST_DIR}")
endif()

## the Qt 6 modules of the public link interface; a newer Qt 6 is binary compatible
find_dependency(Qt6 @Qt6_VERSION@ COMPONENTS ${OpenMSGUI_QT_COMPONENTS})

if(NOT TARGET OpenMS::OpenMS_GUI)
  include("${CMAKE_CURRENT_LIST_DIR}/@_OPENMS_GUI_EXPORT_FILE@")
endif()
if(NOT TARGET OpenMS_GUI)
  add_library(OpenMS_GUI ALIAS OpenMS::OpenMS_GUI)
endif()

check_required_components(OpenMSGUI)
