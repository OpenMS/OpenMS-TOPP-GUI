##############################################################################
## Windows installer of the OpenMS GUI (TOPPView, TOPPAS, INIFileEditor, the
## GUI TOPP tools and Qt).
##
## It is an add-on to the installation of the OpenMS core of the same version:
## it reads the folder and the version of that installation from the registry
## (written by the core installer through NsisMultiUser), installs into the same
## folder, in the same mode (all users or current user), and refuses to run
## without it. It keeps its own uninstall log and uninstaller
## (uninstall-gui.exe) and its own entry in the list of installed programs, so
## that it removes exactly the files it installed. The core installer runs
## uninstall-gui.exe first when it is uninstalled.
##
## CPack configures this file (cmake/package_nsis.cmake): @CPACK_...@ references
## are replaced at packaging time, and the files come from the CPack staging
## tree, which holds the GUI layer only.
##############################################################################

Unicode true
Name "@CPACK_PACKAGE_NAME@"
BrandingText "@CPACK_PACKAGE_FILE_NAME@"
OutFile "@CPACK_TOPLEVEL_DIRECTORY@/@CPACK_OUTPUT_FILE_NAME@"
SetCompressor /SOLID lzma

## Long version has to have 4 levels...
!define VERSION_LONG "@CPACK_PACKAGE_VERSION@.0"
## the full version string, e.g. 3.7.0-pre-nightly-2026-11-07; the core installer writes
## the same string as DisplayVersion
!define VERSION "@CPACK_OPENMS_VERSION@"

!define OPENMSDIRSRC "@CPACK_OPENMS_PROJECT_SOURCE_DIR@"
!define NSISRESOURCES "@CPACK_OPENMS_PROJECT_SOURCE_DIR@/cmake/Windows"

## The staging tree of this packaging run
!define OPENMSPACKAGEDIR "@CPACK_TEMPORARY_DIRECTORY@"
!define OPENMSBINDIR "@CPACK_TEMPORARY_DIRECTORY@/@CPACK_OPENMS_INSTALL_BIN_DIR@"
!define OPENMSSHAREDIR "@CPACK_TEMPORARY_DIRECTORY@/@CPACK_OPENMS_INSTALL_SHARE_DIR@"
!define OPENMSDOCDIR "@CPACK_TEMPORARY_DIRECTORY@/@CPACK_OPENMS_INSTALL_DOC_DIR@"
!define OPENMSINCLUDEDIR "@CPACK_TEMPORARY_DIRECTORY@/@CPACK_OPENMS_INSTALL_INCLUDE_DIR@"
!define OPENMSCMAKEDIR "@CPACK_TEMPORARY_DIRECTORY@/@CPACK_OPENMS_INSTALL_CMAKE_DIR@"

!addplugindir "${NSISRESOURCES}/Plugins/x86-unicode"
!addincludedir "${NSISRESOURCES}/Include"

##################
###   SCRIPT   ###
##################

# which extensions to connect to TOPPView and TOPPAS
!macro OpenMSGUIExtensions _action
  !insertmacro ${_action} ".mzData" "TOPPView"
  !insertmacro ${_action} ".mzXML" "TOPPView"
  !insertmacro ${_action} ".mzML" "TOPPView"
  !insertmacro ${_action} ".sqMass" "TOPPView"
  !insertmacro ${_action} ".dta" "TOPPView"
  !insertmacro ${_action} ".dta2D" "TOPPView"
  !insertmacro ${_action} ".cdf" "TOPPView"
  !insertmacro ${_action} ".idXML" "TOPPView"
  !insertmacro ${_action} ".featureXML" "TOPPView"
  !insertmacro ${_action} ".consensusXML" "TOPPView"
  !insertmacro ${_action} ".toppas" "TOPPAS"
!macroend

## The installation of the OpenMS core: the uninstall key NsisMultiUser writes for it, under
## HKLM (all users) or HKCU (current user). InstallLocation is in this key, DisplayVersion in
## it for an all-users installation and in "<key> (current user)" for a current-user one.
!define CORE_PRODUCT_NAME "OpenMS"
!define CORE_UNINST_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\${CORE_PRODUCT_NAME}"
## The folder of the core's Start menu entries
!define SMFOLDER "OpenMS"

!define APPNAME "OpenMS-GUI"
!define PRODUCT_NAME "${APPNAME}"
# For the icon used by MultiUser plugin, relative to INSTDIR
!define PROGEXE "bin\TOPPView.exe"
# Uninstall key of this installer (NsisMultiUser and AdvUninstLog)
!define PRODUCT_UNINST_ROOT SHCTX
!define PRODUCT_UNINST_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\${PRODUCT_NAME}"
!define COMPANY "OpenMS Developer Team"
!define COMPANY_NAME "${COMPANY}"
!define URL "https://www.OpenMS.de"
!define URL_INFO_ABOUT "${URL}"

# Own uninstall log and uninstaller: the core's (Uninstall.dat, uninstall.exe) are in the same folder
!define UNINSTALL_LOG "Uninstall-GUI"
!define UNINSTALL_FILENAME "uninstall-gui.exe"

# MultiUser defines
!define MULTIUSER_INSTALLMODE_INSTDIR "OpenMS-${VERSION}" # only a fallback: .onInit sets INSTDIR to the core's folder
!define MULTIUSER_INSTALLMODE_DEFAULT_ALLUSERS 1
!define MULTIUSER_INSTALLMODE_64_BIT 1
!define MULTIUSER_INSTALLMODE_NO_HELP_DIALOG 1 # We define our own with additional params later

!include MUI2.nsh
!include Sections.nsh
!include FileFunc.nsh
!include LogicLib.nsh

## NsisMultiUser uses StrRep in the installer and in the uninstaller; newer NSIS versions
## need the functions declared before.
!include StrFunc.nsh
${StrRep}
${UnStrRep}

# Private includes from repo
!include IncludeScript_Misc.nsh
!include AdvUninstLog2.nsh
!include NsisMultiUser.nsh

# For AdvUninstalllog (alternative INTERACTIVE_UNINSTALL will trigger message boxes for each file)
!insertmacro UNATTENDED_UNINSTALL

;--------------------------------
;Interface Configuration

!define MUI_ICON "${NSISRESOURCES}\OpenMS.ico"
!define MUI_UNICON "${NSISRESOURCES}\OpenMS.ico"
!define MUI_HEADERIMAGE
!define MUI_HEADERIMAGE_BITMAP "${NSISRESOURCES}\images\header.bmp"
!define MUI_HEADERIMAGE_UNBITMAP "${NSISRESOURCES}\images\header-uninstall.bmp"
!define MUI_HEADERIMAGE_RIGHT
!define MUI_ABORTWARNING
!define MUI_WELCOMEFINISHPAGE_BITMAP "${NSISRESOURCES}\images\wizard.bmp"
!define MUI_UNWELCOMEFINISHPAGE_BITMAP "${NSISRESOURCES}\images\wizard-uninstall.bmp"

!insertmacro RefreshShellIcons
!insertmacro un.RefreshShellIcons

# UI settings
!define MUI_FINISHPAGE_NOAUTOCLOSE
!define MUI_LICENSEPAGE_RADIOBUTTONS
!define MUI_UNFINISHPAGE_NOAUTOCLOSE

# Remember the installer language
!define MUI_LANGDLL_REGISTRY_ROOT SHCTX
!define MUI_LANGDLL_REGISTRY_KEY "${PRODUCT_UNINST_KEY}"
!define MUI_LANGDLL_REGISTRY_VALUENAME "InstallerLanguage"

# Installer pages. There is no directory page: the GUI goes into the core's folder.
!define MUI_WELCOMEPAGE_TEXT "This wizard installs the OpenMS GUI ${VERSION} (TOPPView, TOPPAS, INIFileEditor and the TOPP tools that need the GUI library) into the installation of OpenMS ${VERSION} in$\r$\n$\r$\n$INSTDIR$\r$\n$\r$\nClose all OpenMS applications before continuing.$\r$\n$\r$\n$_CLICK"
!insertmacro MUI_PAGE_WELCOME
!define MUI_PAGE_CUSTOMFUNCTION_SHOW licpageshow
!insertmacro MUI_PAGE_LICENSE "${OPENMSDIRSRC}\License.txt"
## Required by NsisMultiUser; .onInit chooses the mode of the core installation, so the page
## is never shown.
!insertmacro MULTIUSER_PAGE_INSTALLMODE
!insertmacro MUI_PAGE_COMPONENTS
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH

# Uninstaller pages
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MULTIUSER_UNPAGE_INSTALLMODE
!insertmacro MUI_UNPAGE_INSTFILES

# Installer languages
!insertmacro MUI_LANGUAGE English
!insertmacro MUI_LANGUAGE German
!insertmacro MUI_LANGUAGE French
!insertmacro MULTIUSER_LANGUAGE_INIT

# Custom MUI Function to set font of license display page
# to a mono spaced one.
# from http://stackoverflow.com/questions/8424172/nsis-display-license-with-a-monospace-font
Function licpageshow
    FindWindow $0 "#32770" "" $HWNDPARENT
    CreateFont $1 "Consolas" "8"
    GetDlgItem $0 $0 1000
    SendMessage $0 ${WM_SETFONT} $1 1
FunctionEnd

# predefined installation modes
InstType "Recommended"  #1
InstType "Minimum"      #2
InstType "Full"         #3

CRCCheck on
ShowInstDetails hide
ShowUninstDetails hide
VIProductVersion ${VERSION_LONG}
VIAddVersionKey /LANG=${LANG_ENGLISH} ProductName "${PRODUCT_NAME}"
VIAddVersionKey /LANG=${LANG_ENGLISH} ProductVersion "${VERSION}"
VIAddVersionKey /LANG=${LANG_ENGLISH} CompanyName "${COMPANY}"
VIAddVersionKey /LANG=${LANG_ENGLISH} CompanyWebsite "${URL}"
VIAddVersionKey /LANG=${LANG_ENGLISH} FileVersion "${VERSION}"
VIAddVersionKey /LANG=${LANG_ENGLISH} FileDescription "OpenMS GUI installer"
VIAddVersionKey /LANG=${LANG_ENGLISH} LegalCopyright ""

# Installer sections
Section "GUI applications" SEC_GUI
    SectionIn 1 2 3 RO
    SetOverwrite on

    # The GUI executables, OpenMS_GUI.dll, Qt with its plugins and qt.conf.
    # The import library goes with the development files.
    SetOutPath "$INSTDIR\bin"
    !insertmacro UNINSTALL.LOG_OPEN_INSTALL
    File /r /x "*.lib" "${OPENMSBINDIR}\*.*"
    !insertmacro UNINSTALL.LOG_CLOSE_INSTALL

    # The tool registry of the GUI TOPP tools, the style sheet, the Qt licenses and
    # THIRD-PARTY-NOTICES-GUI.txt; the icons of the associated file types
    SetOutPath "$INSTDIR\share\OpenMS"
    !insertmacro UNINSTALL.LOG_OPEN_INSTALL
    File /r "${OPENMSSHAREDIR}\*.*"
    File "${NSISRESOURCES}\OpenMS_TOPPView.ico"
    File "${NSISRESOURCES}\OpenMS_TOPPAS.ico"
    !insertmacro UNINSTALL.LOG_CLOSE_INSTALL
SectionEnd

!if /FileExists "${OPENMSDOCDIR}\html-gui\index.html"
Section "Documentation" SEC_Doc
    SectionIn 1 3
    SetOverwrite on
    # the folder itself, so that the log has it and the uninstaller removes it
    SetOutPath "$INSTDIR\share\doc"
    !insertmacro UNINSTALL.LOG_OPEN_INSTALL
    File /r "${OPENMSDOCDIR}\html-gui"
    !insertmacro UNINSTALL.LOG_CLOSE_INSTALL
SectionEnd
!endif

!if /FileExists "${OPENMSINCLUDEDIR}\OpenMS\*.*"
Section /o "Development files" SEC_Dev
    SectionIn 3
    SetOverwrite on
    # headers, import library and CMake package of the GUI library
    SetOutPath "$INSTDIR\include"
    !insertmacro UNINSTALL.LOG_OPEN_INSTALL
    File /r "${OPENMSINCLUDEDIR}\*.*"
    !insertmacro UNINSTALL.LOG_CLOSE_INSTALL
    !if /FileExists "${OPENMSBINDIR}\*.lib"
    SetOutPath "$INSTDIR\bin"
    !insertmacro UNINSTALL.LOG_OPEN_INSTALL
    File "${OPENMSBINDIR}\*.lib"
    !insertmacro UNINSTALL.LOG_CLOSE_INSTALL
    !endif
    !if /FileExists "${OPENMSCMAKEDIR}\*.cmake"
    SetOutPath "$INSTDIR\@CPACK_OPENMS_INSTALL_CMAKE_DIR@"
    !insertmacro UNINSTALL.LOG_OPEN_INSTALL
    File /r "${OPENMSCMAKEDIR}\*.*"
    !insertmacro UNINSTALL.LOG_CLOSE_INSTALL
    !endif
SectionEnd
!endif

# Start menu entries, in the folder of the core's entries
Section "-StartMenu" SEC_StartMenu
    CreateDirectory "$SMPROGRAMS\${SMFOLDER}"
    # the working directory of the shortcuts
    SetOutPath "$INSTDIR\bin"
    CreateShortcut "$SMPROGRAMS\${SMFOLDER}\TOPPView.lnk" "$INSTDIR\bin\TOPPView.exe"
    CreateShortcut "$SMPROGRAMS\${SMFOLDER}\TOPPAS.lnk" "$INSTDIR\bin\TOPPAS.exe"
    CreateShortcut "$SMPROGRAMS\${SMFOLDER}\INIFileEditor.lnk" "$INSTDIR\bin\INIFileEditor.exe"
    CreateShortcut "$SMPROGRAMS\${SMFOLDER}\Uninstall OpenMS GUI.lnk" "$INSTDIR\${UNINSTALL_FILENAME}" "/$MultiUser.InstallMode"
SectionEnd

SectionGroup "Register File Extensions" SEC_RegisterExt
    # windows registry info: http://support.microsoft.com/kb/256986
    !insertmacro OpenMSGUIExtensions RegisterExtensionSection

    Section "-RegFileRefreshInternal" SEC_RegFileRefreshInternal
        SectionIn 1 3
        ${RefreshShellIcons}
    SectionEnd
SectionGroupEnd

Section "-post" SEC_Post
    SetOutPath $INSTDIR
    WriteUninstaller "$INSTDIR\${UNINSTALL_FILENAME}"
    # InstallLocation, DisplayVersion, UninstallString, ... in the uninstall key of the GUI
    !insertmacro MULTIUSER_RegistryAddInstallInfo

    # The size of what this installer added (NsisMultiUser would measure the whole folder,
    # the core included)
    Push $0
    Push $1
    Push $2
    StrCpy $1 0
    SectionGetSize ${SEC_GUI} $2
    IntOp $1 $1 + $2
    !ifdef SEC_Doc
    ${If} ${SectionIsSelected} ${SEC_Doc}
        SectionGetSize ${SEC_Doc} $2
        IntOp $1 $1 + $2
    ${EndIf}
    !endif
    !ifdef SEC_Dev
    ${If} ${SectionIsSelected} ${SEC_Dev}
        SectionGetSize ${SEC_Dev} $2
        IntOp $1 $1 + $2
    ${EndIf}
    !endif
    !insertmacro MULTIUSER_GetCurrentUserString $0
    WriteRegDWORD SHCTX "${PRODUCT_UNINST_KEY}$0" "EstimatedSize" $1
    Pop $2
    Pop $1
    Pop $0
SectionEnd

## Sets $CoreMode ("AllUsers" or "CurrentUser") and $CoreDir to the installation of the OpenMS
## core this installer belongs to, or quits with a message if there is none of this version.
Var CoreMode
Var CoreDir
Function FindCoreInstallation
    Push $0
    Push $1
    Push $2
    Push $3

    # all users
    ReadRegStr $0 HKLM "${CORE_UNINST_KEY}" "InstallLocation"
    ReadRegStr $1 HKLM "${CORE_UNINST_KEY}" "DisplayVersion"
    # current user
    ReadRegStr $2 HKCU "${CORE_UNINST_KEY}" "InstallLocation"
    ReadRegStr $3 HKCU "${CORE_UNINST_KEY} (current user)" "DisplayVersion"
    ${If} $3 == ""
        ReadRegStr $3 HKCU "${CORE_UNINST_KEY}" "DisplayVersion"
    ${EndIf}

    StrCpy $CoreMode ""
    # The mode given on the command line (required in silent mode) must be that of the core.
    ${If} $CmdLineInstallMode == "AllUsers"
        ${If} $0 != ""
        ${AndIf} $1 == "${VERSION}"
            StrCpy $CoreMode "AllUsers"
            StrCpy $CoreDir $0
        ${EndIf}
    ${ElseIf} $CmdLineInstallMode == "CurrentUser"
        ${If} $2 != ""
        ${AndIf} $3 == "${VERSION}"
            StrCpy $CoreMode "CurrentUser"
            StrCpy $CoreDir $2
        ${EndIf}
    ${ElseIf} $0 != ""
    ${AndIf} $1 == "${VERSION}"
        StrCpy $CoreMode "AllUsers"
        StrCpy $CoreDir $0
    ${ElseIf} $2 != ""
    ${AndIf} $3 == "${VERSION}"
        StrCpy $CoreMode "CurrentUser"
        StrCpy $CoreDir $2
    ${EndIf}

    ${If} $CoreMode == ""
        StrCpy $R9 ""
        ${If} $0 != ""
            StrCpy $R9 "$R9$\r$\nFound: OpenMS $1 for all users in $0"
        ${EndIf}
        ${If} $2 != ""
            StrCpy $R9 "$R9$\r$\nFound: OpenMS $3 for the current user in $2"
        ${EndIf}
        ${If} $CmdLineInstallMode != ""
            StrCpy $R9 "$R9$\r$\n(looked only for an installation $CmdLineInstallMode, as given on the command line)"
        ${EndIf}
        MessageBox MB_ICONSTOP "The OpenMS GUI ${VERSION} is an add-on to OpenMS ${VERSION}, which is not installed.$\r$\n$R9$\r$\n$\r$\nInstall OpenMS ${VERSION} first (${URL}), then run this installer again." /SD IDOK
        SetErrorLevel 2
        Quit
    ${EndIf}

    ${IfNot} ${FileExists} "$CoreDir\bin\OpenMS.dll"
        MessageBox MB_ICONSTOP "The registry names $CoreDir as the folder of OpenMS ${VERSION}, but $CoreDir\bin\OpenMS.dll does not exist. Reinstall OpenMS ${VERSION}, then run this installer again." /SD IDOK
        SetErrorLevel 2
        Quit
    ${EndIf}

    Pop $3
    Pop $2
    Pop $1
    Pop $0
FunctionEnd

# Installer functions
Function .onInit
    # Command line options
    Push $R0
    Push $R1
    ${GetParameters} $R0
    ClearErrors
    ${GetOptions} $R0 '/?' $R1
    ${IfNot} ${Errors}
        MessageBox MB_ICONINFORMATION "Usage:$\r$\n\
            $\r$\n\
            /allusers$\t- install for all users (where OpenMS is installed for all users)$\r$\n\
            /currentuser$\t- install for the current user (where OpenMS is installed for the current user)$\r$\n\
            /S$\t- silent mode, requires /allusers or /currentuser, case-sensitive$\r$\n\
            /?$\t- display this message$\r$\n\
            $\r$\n\
            The OpenMS GUI is installed into the installation of OpenMS ${VERSION}, which has to be installed first.$\r$\n\
            $\r$\n\
            Return codes (decimal):$\r$\n\
            $\r$\n\
            0$\t- normal execution (no error)$\r$\n\
            1$\t- installation aborted by user (Cancel button)$\r$\n\
            2$\t- installation aborted by script (e.g. OpenMS ${VERSION} is not installed)$\r$\n\
            666660$\t- invalid command-line parameters$\r$\n\
            666661$\t- elevation is not allowed by defines$\r$\n\
            666666$\t- cannot start elevated instance$\r$\n\
            other$\t- Windows error code when trying to start elevated instance"
        SetErrorLevel 0
        Quit
    ${EndIf}
    Pop $R1
    Pop $R0

    !insertmacro MULTIUSER_INIT

    Call FindCoreInstallation

    # The mode of the core installation: all users needs administrator rights, so a
    # non-elevated instance restarts itself elevated (and the elevated one gets here again).
    ${If} $CoreMode == "AllUsers"
        ${If} $IsAdmin = 0
            Call MultiUser.Elevate
            # still here: elevation is not allowed (silent mode)
            MessageBox MB_ICONSTOP "OpenMS ${VERSION} is installed for all users. Run this installer as administrator." /SD IDOK
            SetErrorLevel 666661
            Quit
        ${EndIf}
        Call MultiUser.InstallMode.AllUsers
    ${Else}
        Call MultiUser.InstallMode.CurrentUser
    ${EndIf}
    StrCpy $INSTDIR $CoreDir
    # the install mode page
    StrCpy $DisplayDialog 0

    !insertmacro UNINSTALL.LOG_PREPARE_INSTALL
    !insertmacro MUI_LANGDLL_DISPLAY
FunctionEnd

Function .onInstSuccess
   !insertmacro UNINSTALL.LOG_UPDATE_INSTALL
FunctionEnd

# set the component descriptions after the Sections have been defined!
!insertmacro MUI_FUNCTION_DESCRIPTION_BEGIN
!insertmacro MUI_DESCRIPTION_TEXT ${SEC_GUI} "TOPPView, TOPPAS, INIFileEditor, ExecutePipeline and ImageCreator, the GUI library and Qt"
!ifdef SEC_Doc
!insertmacro MUI_DESCRIPTION_TEXT ${SEC_Doc} "Documentation of the GUI applications and the GUI library"
!endif
!ifdef SEC_Dev
!insertmacro MUI_DESCRIPTION_TEXT ${SEC_Dev} "Headers, import library and CMake package of the GUI library, for programs that use it"
!endif
!insertmacro MUI_DESCRIPTION_TEXT ${SEC_RegisterExt} "Open certain file types (e.g., '.mzML') with TOPPView and '.toppas' with TOPPAS"
!insertmacro MUI_FUNCTION_DESCRIPTION_END

################
## UNINSTALL ###
################

Section "-Uninstall"
    # remove the file associations
    !insertmacro OpenMSGUIExtensions UnRegisterExtensionSection
    ${un.RefreshShellIcons}

    # remove the Start menu entries; the folder only if the core has none left in it
    Delete "$SMPROGRAMS\${SMFOLDER}\TOPPView.lnk"
    Delete "$SMPROGRAMS\${SMFOLDER}\TOPPAS.lnk"
    Delete "$SMPROGRAMS\${SMFOLDER}\INIFileEditor.lnk"
    Delete "$SMPROGRAMS\${SMFOLDER}\Uninstall OpenMS GUI.lnk"
    RmDir "$SMPROGRAMS\${SMFOLDER}"

    # delete the installed files: only those in the log, never a file of the core
    !insertmacro UNINSTALL.NEW_UNINSTALL

    # Remove the uninstaller from registry as the very last step - if sth. goes wrong, let the user run it again
    !insertmacro MULTIUSER_RegistryRemoveInstallInfo
SectionEnd

# UnInstaller functions
Function un.onInit
    !insertmacro MULTIUSER_UNINIT
    !insertmacro MUI_UNGETLANGUAGE
FunctionEnd
