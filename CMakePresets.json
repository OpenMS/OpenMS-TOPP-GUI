            "name": "linux-arm64-relwithdebinfo",
            "configurePreset": "linux-arm64-relwithdebinfo"
        },
        {
            "name": "linux-arm64-release",
            "configurePreset": "linux-arm64-release"
        },
        {
            "name": "macos-arm64-debug",
            "configurePreset": "macos-arm64-debug"
        },
        {
            "name": "macos-arm64-relwithdebinfo",
            "configurePreset": "macos-arm64-relwithdebinfo"
        },
        {
            "name": "macos-arm64-release",
            "configurePreset": "macos-arm64-release"
        },
        {
            "name": "windows-x64-debug",
            "configurePreset": "windows-x64-debug"
        },
        {
            "name": "windows-x64-relwithdebinfo",
            "configurePreset": "windows-x64-relwithdebinfo"
        },
        {
            "name": "windows-x64-release",
            "configurePreset": "windows-x64-release"
        },
        {
            "name": "linux-x64-ci",
            "configurePreset": "linux-x64-ci"
        },
        {
            "name": "linux-arm64-ci",
            "configurePreset": "linux-arm64-ci"
        },
        {
            "name": "macos-arm64-ci",
            "configurePreset": "macos-arm64-ci"
        },
        {
            "name": "windows-x64-ci",
            "configurePreset": "windows-x64-ci"
        }
    ],
    "testPresets": [
        {
            "name": "test-base",
            "hidden": true,
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            },
            "environment": {
                "QT_QPA_PLATFORM": "offscreen"
            }
        },
        {
            "name": "test-base-ci",
            "hidden": true,
            "execution": {
                "jobs": 4
            }
        },
        {
            "name": "linux-x64-debug",
            "configurePreset": "linux-x64-debug",
            "inherits": "test-base"
        },
        {
            "name": "linux-x64-relwithdebinfo",
            "configurePreset": "linux-x64-relwithdebinfo",
            "inherits": "test-base"
        },
        {
            "name": "linux-x64-release",
            "configurePreset": "linux-x64-release",
            "inherits": "test-base"
        },
        {
            "name": "linux-arm64-debug",
            "configurePreset": "linux-arm64-debug",
