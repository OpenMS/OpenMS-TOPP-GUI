        },
        {
            "name": "macos-arm64-release",
            "configurePreset": "macos-arm64-release",
            "inherits": "test-base"
        },
        {
            "name": "windows-x64-debug",
            "configurePreset": "windows-x64-debug",
            "inherits": "test-base"
        },
        {
            "name": "windows-x64-relwithdebinfo",
            "configurePreset": "windows-x64-relwithdebinfo",
            "inherits": "test-base"
        },
        {
            "name": "windows-x64-release",
            "configurePreset": "windows-x64-release",
            "inherits": "test-base"
        },
        {
            "name": "linux-x64-ci",
            "configurePreset": "linux-x64-ci",
            "inherits": [
                "test-base",
                "test-base-ci"
            ]
        },
        {
            "name": "linux-arm64-ci",
            "configurePreset": "linux-arm64-ci",
            "inherits": [
